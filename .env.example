# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by getStaticProps and Next API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# On-demand ISR revalidation (same value in both; generate with `openssl rand -hex 24`)
REVALIDATE_SECRET=change-me
NEXT_PUBLIC_REVALIDATE_SECRET=change-me

# Canonical site origin (SEO, sitemaps)
NEXT_PUBLIC_SITE_URL=https://deepskills.pk

# Verified public business phone for structured data; omitted when unset.
# NEXT_PUBLIC_BUSINESS_PHONE=your-verified-public-phone

# Required in production: SMTP for OTP and admission/notification email
# If omitted on localhost, OTPs are printed to terminal and auto-filled in the UI for instant testing.
# SMTP_HOST=mail-provider-hostname
# SMTP_PORT=587
# SMTP_USER=your-sending-mailbox
# SMTP_PASS=enter-securely-on-the-server
# SMTP_FROM="DeepSkills <info@deepskills.pk>"

# Optional
# NEXT_PUBLIC_GSC_VERIFICATION=google-search-console-token
# CONTACT_EMAIL_TO=info@deepskills.pk
# HR_EMAIL_TO=info@deepskills.pk
# CRON_SECRET=change-me

# --- Website chatbot (optional) ---
# With no key the assistant answers from the local knowledge base only.
# Set one provider and its key to have answers written by an AI model that is
# restricted to the same site content.
# CHAT_AI_PROVIDER=claude          # claude | openai | deepseek
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# CHAT_AI_MODEL=                   # optional override, e.g. claude-haiku-4-5
# CHAT_AI_TIMEOUT_MS=12000         # falls back to keyword answers after this
# CHAT_AI_BASE_URL=                # optional: gateway/proxy or compatible endpoint
